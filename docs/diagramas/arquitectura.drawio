<mxfile host="drawio" agent="inventario-upb" version="24.7.17"><diagram id="p1" name="Arquitectura"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1096" background="#f4f6fa" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="marco" value="" style="rect;fillColor=none;strokeColor=none;html=1;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1640" height="1096" as="geometry"/></mxCell><mxCell id="c1" value='&lt;div style="font-size:12px;font-weight:800;letter-spacing:0.14em;color:#2563eb;"&gt;ARQUITECTURA&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="font-size:32px;font-weight:800;letter-spacing:-0.02em;color:#0f172a;"&gt;Componentes del sistema&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:15px;font-weight:500;color:#475569;line-height:1.5;"&gt;Aplicación Angular estática, Supabase como backend y Microsoft 365 para la autenticación y el Excel oficial. El navegador se comunica directamente con Supabase.&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:0px;letter-spacing:-0.01em;"&gt;Visitante&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;Sin sesión. Consulta la galería pública.&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=72;spacingRight=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="370" height="92" as="geometry"/></mxCell><mxCell id="c5" value="V" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=none;fontColor=#475569;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="56" y="201.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:0px;letter-spacing:-0.01em;"&gt;Cuenta UPB&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;Inicia sesión con Microsoft. Con el rol &quot;usuario&quot; accede a lo mismo que un visitante.&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=72;spacingRight=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="430" y="176" width="370" height="92" as="geometry"/></mxCell><mxCell id="c7" value="U" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=none;fontColor=#475569;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="446" y="201.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:0px;letter-spacing:-0.01em;"&gt;Administrador&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;Accede a los datos restringidos, edita el inventario y sincroniza.&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfd0f5;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=72;spacingRight=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="820" y="176" width="370" height="92" as="geometry"/></mxCell><mxCell id="c9" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="836" y="201.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:0px;letter-spacing:-0.01em;"&gt;Personal de la biblioteca&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;Mantiene el Excel oficial desde Excel.&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=72;spacingRight=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="1210" y="176" width="390" height="92" as="geometry"/></mxCell><mxCell id="c11" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cbd5e1;strokeColor=none;fontColor=#334155;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="1226" y="201.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="font-size:11px;font-weight:800;letter-spacing:0.14em;color:#1d4ed8;"&gt;NAVEGADOR, SITIO ESTÁTICO EN NETLIFY&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=44;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#bfd0f5;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="860" height="210" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#1d4ed8;"&gt;ANGULAR 20&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Portal del inventario&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;Galería y ficha de cada obra&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Registrar y editar obras&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Resumen, Mapa y sincronización&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfd0f5;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="400" height="146" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#2563eb;"&gt;ENTREGA&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Netlify&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;Sirve el build estático&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;CSP estricta: sin iframes ni scripts de terceros&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Edge function: la relaja solo en &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;/complemento&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="480" y="378" width="400" height="146" as="geometry"/></mxCell><mxCell id="c15" value='&lt;div style="font-size:11px;font-weight:800;letter-spacing:0.14em;color:#64748b;"&gt;EXCEL EN LA WEB O DE ESCRITORIO&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=44;whiteSpace=wrap;html=1;fillColor=#f1f4f8;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="940" y="336" width="660" height="210" as="geometry"/></mxCell><mxCell id="c16" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#1d4ed8;"&gt;LA MISMA APP, DENTRO DE EXCEL&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Complemento&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;&lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;/complemento&lt;/span&gt; en un panel&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Misma pantalla de sincronización&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Lee y escribe con Office.js&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfd0f5;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="960" y="378" width="300" height="146" as="geometry"/></mxCell><mxCell id="c17" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#64748b;"&gt;EXCEL&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Libro abierto&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;El Excel oficial, abierto por quien lo edita&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;El complemento usa esos permisos&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="1280" y="378" width="300" height="146" as="geometry"/></mxCell><mxCell id="c18" value='&lt;div style="font-size:11px;font-weight:800;letter-spacing:0.14em;color:#64748b;"&gt;SUPABASE, BACKEND&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=44;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="40" y="686" width="860" height="230" as="geometry"/></mxCell><mxCell id="c19" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#2563eb;"&gt;AUTH&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Sesiones&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;Solo Microsoft Entra (proveedor azure)&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Sin registro público&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Sin contraseña&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="250" height="166" as="geometry"/></mxCell><mxCell id="c20" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#2563eb;"&gt;POSTGRES&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;Base de datos&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;&lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;obras&lt;/span&gt;, &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;imagenes&lt;/span&gt;, &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;responsables&lt;/span&gt;, &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;usuarios&lt;/span&gt; y la sincronización&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;RLS y permisos por columna&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Vista &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;obras_admin&lt;/span&gt; y RPC &lt;span style="font-family:ui-monospace,Menlo,monospace;font-size:0.92em;"&gt;aplicar_sincronizacion&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="325" y="728" width="320" height="166" as="geometry"/></mxCell><mxCell id="c21" value='&lt;div style="font-size:10.5px;font-weight:800;letter-spacing:0.14em;color:#2563eb;"&gt;STORAGE&lt;/div&gt;&lt;div style="font-size:15px;font-weight:800;color:#0f172a;margin-top:3px;letter-spacing:-0.01em;"&gt;imagenes-obras&lt;/div&gt;&lt;div style="font-size:12.5px;font-weight:500;color:#475569;margin-top:6px;line-height:1.5;"&gt;&lt;div style="margin-top:0px;"&gt;Lectura pública&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Escritura solo admin&lt;/div&gt;&lt;div style="margin-top:3px;"&gt;Máx. 5 MB en JPG, PNG o WEBP&lt;/div&gt;&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;spacingBottom=0;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrope;" vertex="1" parent="1"><mxGeometry x="660" y="728" width="220" height="166" as="geometry"/></mxCell><mxCell id="c22" value='&lt;div style="font-size:11px;font-weight:800;letter-spacing:0.14em;color:#64748b;"&gt;MICROSOFT 365, TENANT UPB&lt;/div&gt;' style="rounded=1;absoluteArcSize=1;arcSize=44;whiteSpace=wrap;html=1;fillColor=#f1f4f8;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;fontFamily=Manrope;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DManrop