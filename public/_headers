# El hash de script-src es el del script del tema en src/index.html: si se cambia ese script, hay que recalcularlo.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-JEhiDTnsb18z0I1b1a5Wd1AywRQiJ7SvNpGuW0qmpSI='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Los assets con hash en el nombre son inmutables
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# El HTML nunca se cachea, para que los despliegues se vean de inmediato
/index.html
  Cache-Control: public, max-age=0, must-revalidate
